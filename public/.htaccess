# ----------------------------------------------------------------------
# 1. Default Directory Index (Prevents 403 Forbidden on root /)
# ----------------------------------------------------------------------
DirectoryIndex index.html index.php

# ----------------------------------------------------------------------
# 2. React SPA Client-Side Routing for Hostinger / LiteSpeed / Apache
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve index.html directly for the root URL (prevents 403 Directory Listing error)
  RewriteRule ^$ index.html [L]

  # If requesting index.html directly, stop rewriting
  RewriteRule ^index\.html$ - [L]

  # If the requested path is an existing file, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If the requested path is an existing directory with its own index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Route all other URLs (e.g. /work, /why-me, /services) to /index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Security Headers for Live Site Hardening
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Protect against clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Referrer policy for privacy & security
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Prevent sensitive caching of HTML files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

